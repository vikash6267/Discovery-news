# Copy to .env on the VPS and fill every value.  (deploy/setup-vps.sh does the copy for you)

# PORT is filled automatically with a free port by deploy/setup-vps.sh
PORT=8080

# MongoDB Atlas connection string.  Atlas -> Network Access -> add THIS VPS's public IP.
# For the lowest latency choose the Atlas cluster region closest to the VPS (e.g. Mumbai if the VPS is in India).
MONGODB_URL=

# Long random string.  Generate:  openssl rand -hex 48     (changing it logs everyone out)
JWT_SECRET=

# Websites allowed to call the API from a browser (comma separated)
CORS_ORIGINS=https://www.mpupdate.com,https://mpupdate.com

# Image uploads -> Amazon S3 (or S3-compatible: Wasabi, DigitalOcean Spaces, Cloudflare R2, MinIO)
# Bucket must allow public READ of the objects (bucket policy), e.g. s3:GetObject for arn:aws:s3:::BUCKET/mpupdate/*
S3_BUCKET=
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FOLDER=mpupdate
# optional: CloudFront / custom domain used for image links, e.g. https://cdn.mpupdate.com
S3_PUBLIC_URL=
# optional: only for non-AWS providers
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false

# Mail (OTP etc.)
MAIL_HOST=smtp.gmail.com
MAIL_USER=
MAIL_PASS=
