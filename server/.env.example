PORT=8080
MONGODB_URL=
JWT_SECRET=
# Image uploads -> Amazon S3 (or S3-compatible: Wasabi, DigitalOcean Spaces, Cloudflare R2, MinIO)
# Photos must be publicly readable (bucket policy: s3:GetObject on arn:aws:s3:::BUCKET/mpupdate.com/*)
AWS_S3_BUCKET=
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BASE_FOLDER=mpupdate.com
# optional: CloudFront / custom domain used for image links, e.g. https://cdn.mpupdate.com
S3_PUBLIC_URL=
# optional: only for non-AWS providers
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
MAIL_HOST=smtp.gmail.com
MAIL_USER=
MAIL_PASS=
